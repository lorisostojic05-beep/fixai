# Copia questo file in .env.local e compila i valori.
# .env.local non finisce mai in git.

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_o_test_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_o_test_xxxxxxxx

# Firma dei webhook Stripe.
#
# Senza, /api/stripe-webhook risponde 500 e RIFIUTA tutto: un saldo pagato
# resterebbe invisibile e la riparazione ferma come se il cliente non avesse
# mai pagato. Non e' un ripiego silenzioso, e' voluto — fidarsi di una
# chiamata non firmata sarebbe peggio.
#
# In locale il valore lo stampa Stripe CLI quando lancia:
#   stripe listen --api-key <sk_test> --forward-to http://localhost:3000/api/stripe-webhook
#
# In produzione e' il "segreto di firma" della destinazione configurata su
# Stripe. Test e reale hanno DUE segreti diversi.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Resend (email) — https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# Da quale indirizzo partono le email.
#
# Se lo lasci vuoto si ripiega sul mittente di prova di Resend, che consegna
# SOLO alla casella dell'account Resend: le email ai tecnici e ai clienti
# spariscono senza errore visibile. In locale mettilo uguale a Vercel.
EMAIL_MITTENTE=Fixi <assistenza@fixiai.it>

# Dove arrivano le risposte: il mittente e' un indirizzo senza casella, quindi
# chi preme "Rispondi" scriverebbe nel vuoto. Se lo ometti c'e' un ripiego nel
# codice (lib/email-mittente.js).
# EMAIL_RISPOSTA=tuo@indirizzo.it

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx
# Service role key: SOLO server-side, non esporla mai al frontend
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# Password della dashboard /admin
ADMIN_PASSWORD=scegli-una-password-lunga

# Solo per sviluppo locale: salta la verifica del pagamento Stripe.
# Mai in produzione — aprirebbe la diagnosi a chiunque.
# SKIP_PAYMENT_CHECK=true
